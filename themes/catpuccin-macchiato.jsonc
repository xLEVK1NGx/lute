// LUTE adaptation of Catppuccin Macchiato.
// Palette: https://github.com/catppuccin/palette
// Aims for a soft rounded look. Use with an anime landscape wallpaper!!
{
    "metadata": {
        "name": "Catppuccin Macchiato",
        "authors": [
            "Catppuccin Org"
        ],
        "theme_version": "1.0.0",
        "lute_version": "1.0.0",
        "variant": "dark",
        "description": "Catppuccin Macchiato flavor adapted for LUTE.",
        "lightest_ver": "catpuccin-latte",
        "lighter_ver": "catpuccin-frappe",
        "darker_ver": "catpuccin-mocha",
        "darkest_ver": "catpuccin-mocha"
    },
    "colors": {
        "palette": {
            "black": "#181926",
            "white": "#cad3f5",
            "gray": {
                "dark": "#494d64",
                "base": "#6e738d",
                "light": "#b8c0e0"
            },
            "red": "#ed8796",
            "orange": "#f5a97f",
            "yellow": "#eed49f",
            "green": "#a6da95",
            "cyan": "#8bd5ca",
            "blue": "#8aadf4",
            "purple": "#c6a0f6",
            "pink": "#f5bde6"
        },
        "UI": {
            "background": "#24273a",
            "surface": "#363a4f",
            "foreground": "#cad3f5",
            "accent": "palette.purple",
            "accent_alt": "#b7bdf8",
            "selection": "#f4dbd6",
            "hover": "#494d64",
            "overlay": "#1e2030",
            "text": {
                "base": "#cad3f5",
                "muted": "#a5adcb",
                "disabled": "#6e738d",
                "inverse": "#24273a"
            },
            "border": {
                "base": "#6e738d",
                "focused": "#b7bdf8"
            }
        },
        "semantic": {
            "info": "palette.blue.base",
            "warning": "palette.yellow.base",
            "error": "palette.red.base",
            "success": "palette.green.base",
            "feedback": "#b8c0e0"
        },
        "terminal": {
            "background_opacity": 0.75,
            "ansi": {
                "0": "#494d64",
                "1": "#ed8796",
                "2": "#a6da95",
                "3": "#eed49f",
                "4": "#8aadf4",
                "5": "#f5bde6",
                "6": "#8bd5ca",
                "7": "#a5adcb",
                "8": "#5b6078",
                "9": "#ec7486",
                "10": "#8ccf7f",
                "11": "#e1c682",
                "12": "#78a1f6",
                "13": "#f2a9dd",
                "14": "#63cbc0",
                "15": "#b8c0e0"
            },
            "foreground": "#cad3f5",
            "background": "#24273a",
            "cursor": "#f4dbd6",
            "cursor_text": "#24273a",
            "selection": {
                "background": "#f4dbd6",
                "foreground": "#24273a"
            },
            "url": "#f4dbd6",
            "tabs": {
                "active_background": "#c6a0f6",
                "active_foreground": "#181926",
                "inactive_background": "#1e2030",
                "inactive_foreground": "#cad3f5"
            }
        }
    },
    "geometry": {
        "corner_shape": "round",
        "corner_radius": 12,
	"gaps": 8,
	"border_width": 3
    }
}
