// Bundled defaults. Themes and user layers override these values.
// Effect scopes are intentionally empty: post-merge normalization fills them
// from the corresponding default, without masking theme-specific defaults.
// Metadata is omitted: it belongs to the selected theme, not global defaults.
// Most defaults are intentionally basic; optional shadow falloff is 0.
{
    "colors": {
        "palette": {
            "black": "#000000",
            "white": "#ffffff",
            "gray": "#808080",
            "red": "#ff0000",
            "orange": "#ff8000",
            "yellow": "#ffff00",
            "green": "#00ff00",
            "cyan": "#00ffff",
            "blue": "#0000ff",
            "purple": "#800080",
            "pink": "#ff00ff"
        },
        "UI": {
            "background": "palette.black",
            "surface": "palette.gray.dark",
            "foreground": "palette.white",
            "accent": "palette.orange",
            "accent_alt": "palette.orange.dark",
            "selection": "palette.orange",
            "hover": "palette.gray",
            "overlay": "palette.black",
            "text": {
                "base": "UI.foreground",
                "muted": "palette.gray",
                "disabled": "palette.gray.dark",
                "inverse": "UI.background"
            },
            "border": {
                "base": "palette.gray.dark",
                "focused": "UI.accent"
            }
        },
        "semantic": {
            "info": "palette.blue.base",
            "warning": "palette.yellow.base",
            "error": "palette.red.base",
            "success": "palette.green.base",
            "feedback": "palette.gray.light"
        },
        "terminal": {
            "background_opacity": 1,
            "ansi": {
                "0": "palette.black",
                "1": "palette.red.base",
                "2": "palette.green.base",
                "3": "palette.yellow.base",
                "4": "palette.blue.base",
                "5": "palette.pink.base",
                "6": "palette.cyan.base",
                "7": "palette.gray.light",
                "8": "palette.gray.base",
                "9": "palette.red.light",
                "10": "palette.green.light",
                "11": "palette.yellow.light",
                "12": "palette.blue.light",
                "13": "palette.pink.light",
                "14": "palette.cyan.light",
                "15": "palette.white"
            },
            "foreground": "UI.foreground.base",
            "background": "UI.background.base",
            "cursor": "UI.foreground.base",
            "cursor_text": "UI.background.base",
            "url": "UI.accent.base",
            "selection": {
                "background": "UI.selection.base",
                "foreground": "UI.background.base"
            },
            "tabs": {
                "active_background": "UI.accent.base",
                "active_foreground": "UI.background.base",
                "inactive_background": "UI.surface.base",
                "inactive_foreground": "UI.foreground.base"
            }
        }
    },
    "geometry": {
        "corner_shape": "sharp",
        "corner_radius": 0,
        "border_width": 0,
        "gaps": 0
    },
    "spacing": {
        "padding": {
            "sm": 0,
            "md": 0,
            "lg": 0
        },
        "margin": {
            "sm": 0,
            "md": 0,
            "lg": 0
        }
    },
    "fonts": {
        "sizes": {
            "min": 10,
            "base": 12,
            "max": 18
        },
        "normal": {
            "family": "sans-serif",
            "style": "normal"
        },
        "serif": {
            "family": "serif",
            "style": "normal"
        },
        "monospace": {
            "family": "monospace",
            "style": "normal"
        },
        "title": {
            "family": "sans-serif",
            "style": "normal"
        },
        "small": {
            "family": "sans-serif",
            "style": "normal"
        }
    },
    "effects": {
        "blur": {
            "default": {
                "enabled": false,
                "size": 0,
                "passes": 0,
                "noise": 0
            },
            "window_bg": {},
            "inactive_windows": {},
            "overlay": {},
            "panel": {},
            "wallpaper": {}
        },
        "glass": {
            "default": {
                "enabled": false,
                "blur": 0,
                "tint": "palette.white",
                "tint_opacity": 0,
                "noise": 0,
                "border": false,
                "highlight": {
                    "enabled": false,
                    "color": "palette.white",
                    "opacity": 0,
                    "position": "top"
                }
            },
            "panel": {},
            "overlay": {},
            "interactive": {},
            "active_window": {},
            "inactive_windows": {}
        },
        "opacity": {
            "default": {
                "value": 1
            },
            "active_window": {},
            "inactive_windows": {},
            "window_bg": {},
            "panel": {}
        },
        "dimming": {
            "default": {
                "enabled": false,
                "strength": 0
            },
            "active_window": {},
            "inactive_windows": {},
            "overlay": {}
        },
        "shadows": {
            "default": {
                "enabled": false,
                "range": 0,
                "offset_x": 0,
                "offset_y": 0,
                "color": "palette.black",
                "falloff": 0
            },
            "window_bg": {},
            "overlay": {},
            "panel": {}
        },
        "pixelate": {
            "default": {
                "enabled": false,
                "block_size": 1
            },
            "full_screen": {},
            "wallpaper": {},
            "app_icons": {}
        },
        "glow": {
            "default": {
                "enabled": false,
                "color": "UI.accent.base",
                "range": 0,
                "intensity": 0
            },
            "active_window": {},
            "window_bg": {},
            "overlay": {}
        },
        "saturation": {
            "default": {
                "value": 100
            },
            "full_screen": {},
            "wallpaper": {},
            "inactive_windows": {}
        }
    }
}
