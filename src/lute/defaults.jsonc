{
    // LUTE bundled defaults. Later layers override these values.
    // Theme-specific metadata and variant links are intentionally omitted.
    "colors": {
        "palette": {
            "black": "#000000",
            "white": "#ffffff",
            "gray": "#707070",
            "red": "#e7024e",
            "orange": "#ff812e",
            "yellow": "#e5e34f",
            "green": "#05e06f",
            "cyan": "#01dbdb",
            "blue": "#3838ff",
            "purple": "#a855ff",
            "pink": "#ec4cc6"
        },
        "UI": {
            "background": "palette.black",
            "surface": "palette.gray.dark",
            "foreground": "palette.white",
            "accent": "palette.orange",
            "accent_alt": "palette.orange.dark",
            "selection": "palette.orange",
            "hover": "palette.gray",
            "overlay": "palette.black",
            "text": {
                "base": "UI.foreground",
                "muted": "palette.gray",
                "disabled": "palette.gray.dark",
                "inverse": "UI.background"
            },
            "border": {
                "base": "palette.gray.dark",
                "focused": "UI.accent"
            }
        },
        "semantic": {
            "info": "palette.blue.base",
            "warning": "palette.yellow.base",
            "error": "palette.red.base",
            "success": "palette.green.base",
            "feedback": "palette.gray.light"
        },
        "terminal": {
            // Default indexed ANSI mapping; later layers can override slots.
            "ansi": {
                "0": "palette.black",
                "1": "palette.red.base",
                "2": "palette.green.base",
                "3": "palette.yellow.base",
                "4": "palette.blue.base",
                "5": "palette.pink.base",
                "6": "palette.cyan.base",
                "7": "palette.gray.light",
                "8": "palette.gray.base",
                "9": "palette.red.light",
                "10": "palette.green.light",
                "11": "palette.yellow.light",
                "12": "palette.blue.light",
                "13": "palette.pink.light",
                "14": "palette.cyan.light",
                "15": "palette.white"
            },
            "foreground": "UI.foreground.base",
            "background": "UI.background.base",
            "cursor": "UI.foreground.base",
            "cursor_text": "UI.background.base",
            "url": "UI.accent.base",
            "selection": {
                "background": "UI.selection.base",
                "foreground": "UI.background.base"
            },
            "tabs": {
                "active_background": "UI.accent.base",
                "active_foreground": "UI.background.base",
                "inactive_background": "UI.surface.base",
                "inactive_foreground": "UI.foreground.base"
            }
        }
    },

    "geometry": {
        "corner_shape": "round",
        "corner_radius": 8,
        "border_width": 2,
        "gaps": 4
    },
    "spacing": {
        "padding": { "sm": 4, "md": 8, "lg": 16 },
        "margin": { "sm": 4, "md": 8, "lg": 16 }
    },
    "fonts": {
        "sizes": { "min": 10, "base": 12, "max": 18 },
        "normal": { "family": "sans-serif", "style": "normal" },
        "serif": { "family": "serif", "style": "normal" },
        "monospace": { "family": "monospace", "style": "normal" },
        "title": { "family": "sans-serif", "style": "normal" },
        "small": { "family": "sans-serif", "style": "normal" }
    },

    // Effect defaults are neutral or disabled. Scope blocks are intentionally
    // omitted: the current parser does not yet implement scope inheritance.
    "effects": {
        "blur": {
            "default": { "enabled": false, "strength": 0, "passes": 0, "noise": 0 }
        },
        "glass": {
            "default": {
                "enabled": false,
                "blur": 0,
                "tint": "palette.white",
                "tint_opacity": 0,
                "noise": 0,
                "border": false,
                "highlight": {
                    "enabled": false,
                    "color": "palette.white",
                    "opacity": 0,
                    "position": "top"
                }
            }
        },
        "opacity": {
            "default": { "value": 1 }
        },
        "dimming": {
            "default": { "enabled": false, "strength": 0 }
        },
        "shadows": {
            "default": {
                "enabled": false,
                "range": 0,
                "offset_x": 0,
                "offset_y": 0,
                "color": "palette.black"
            }
        },
        "pixelate": {
            "default": { "enabled": false, "block_size": 1 }
        },
        "glow": {
            "default": {
                "enabled": false,
                "color": "UI.accent.base",
                "range": 0,
                "intensity": 0
            }
        },
        "saturation": {
            "default": { "value": 100 }
        }
    }
}
