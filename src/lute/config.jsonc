{
    // Theme filename without the .jsonc extension.
    "selected_theme": "default",

    // EZ mode is not fully supported yet, don't try it.
    "ez_mode": false,

    // Enable plugins for apps you want LUTE to theme.
    // Of course, an app that's enabled also needs to be installed.
    "enabled_plugins": {
        "kitty": false,
        "hyprland": false,
        "quickshell": false
    }
}
